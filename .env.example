# ==============================================================================
# BONDFIRE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or inject into Railway / Render / AWS Secrets Manager
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://bondfire.app

# Database & Cache
DATABASE_URL=postgresql://bondfire_user:SecurePostgresPassword2026!@postgres:5432/bondfire_db?sslmode=prefer
REDIS_URL=redis://:SecureRedisPassword2026!@redis:6379/0

# Security & Sessions
JWT_SECRET=super_secret_jwt_encryption_key_min_32_characters_long_bondfire_2026
SESSION_ENCRYPTION_KEY=32_byte_aes_gcm_hex_key_for_encrypting_local_vault_payloads

# Google Identity Services (OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# Print-on-Demand Keepsakes (Gelato Dropship API)
# Net margin: 45-52% on 8x8 archival hardcover yearbooks
GELATO_API_KEY=gelato_live_api_key_xxxxxxxxxxxxxxxxxxxxxxxx
GELATO_API_ENDPOINT=https://order.gelatoapis.com/v4/orders

# Monetization & Payments (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_POD_PRO_MONTHLY=price_pod_pro_monthly_499
STRIPE_PRICE_POD_PRO_ANNUAL=price_pod_pro_annual_4500

# Encrypted User Media Storage (Cloudflare R2 / S3-Compatible)
# Zero-AI-Training Guaranteed & Private Buckets
R2_ACCOUNT_ID=cloudflare_r2_account_id_here
R2_ACCESS_KEY_ID=r2_access_key_id_here
R2_SECRET_ACCESS_KEY=r2_secret_access_key_here
R2_BUCKET_NAME=bondfire-user-vault-media
R2_PUBLIC_DOMAIN=https://media-vault.bondfire.app

# Google Gemini 1.5 Flash (Free AI Trivia & Chat OCR Roasts)
# Get from https://aistudio.google.com/ (15 RPM / 1,500 requests/day free forever)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Supabase Cloud PostgreSQL (Alternative Free Cloud DB)
# Get from https://supabase.com/ (500MB DB, 50,000 MAU free forever)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGci_your_supabase_anon_key_here
